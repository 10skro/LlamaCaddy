{
  "productName": "LlamaCaddy",
  "version": "0.9.0",
  "identifier": "llamacaddy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/icon.ico",
      "icons/128x128@2x.png",
      "icons/128x128.png",
      "icons/32x32.png"
    ]
  }
}